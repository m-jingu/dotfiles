{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#D8DEE9",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#A0A8B7"
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#88C0D0",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#2E3440",
    "background_color": "#88C0D0",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#88C0D0",
    "underline": true
  },
  "h3": {
    "prefix": "### ",
    "color": "#81A1C1"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#8FBCBB"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#B48EAD"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#8FBCBB",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#4C566A",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#81A1C1",
    "underline": true
  },
  "link_text": {
    "color": "#8FBCBB",
    "bold": true
  },
  "image": {
    "color": "#B48EAD",
    "underline": true
  },
  "image_text": {
    "color": "#616E88",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#EBCB8B",
    "background_color": "#2E3440"
  },
  "code_block": {
    "color": "#D8DEE9",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#dadada"
      },
      "error": {
        "color": "#eeeeee",
        "background_color": "#d75f5f"
      },
      "comment": {
        "color": "#8787af"
      },
      "comment_preproc": {
        "color": "#87afd7"
      },
      "keyword": {
        "color": "#87afd7"
      },
      "keyword_reserved": {
        "color": "#87afd7"
      },
      "keyword_namespace": {
        "color": "#87afd7"
      },
      "keyword_type": {
        "color": "#87afaf"
      },
      "operator": {
        "color": "#87afd7"
      },
      "punctuation": {
        "color": "#eeeeee"
      },
      "name": {
        "color": "#dadada"
      },
      "name_builtin": {
        "color": "#87afd7"
      },
      "name_tag": {
        "color": "#87afd7"
      },
      "name_attribute": {
        "color": "#87afaf"
      },
      "name_class": {
        "color": "#87d7d7",
        "underline": true,
        "bold": true
      },
      "name_constant": {},
      "name_decorator": {
        "color": "#d7af87"
      },
      "name_exception": {},
      "name_function": {
        "color": "#87d7d7"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {
        "color": "#d7afd7"
      },
      "literal_date": {},
      "literal_string": {
        "color": "#afd787"
      },
      "literal_string_escape": {
        "color": "#ffd787"
      },
      "generic_deleted": {
        "color": "#d75f5f"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#afd787"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#8787af"
      },
      "background": {}
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}