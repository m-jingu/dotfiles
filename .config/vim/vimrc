" ============================================
" Vim configuration
" ============================================
" Sections:
" 1. Plugin management (NeoBundle)
" 2. Basic settings
" 3. Key mappings
" 4. Japanese text support
" 5. Status line (lightline)
" 6. Local overrides (vimrc.local)

" ============================================
" Basics
" ============================================
" Turn off vi compatibility to get the full Vim feature set
if &compatible
    set nocompatible
endif

" Filetype detection is switched off until the plugins are loaded
filetype off

" XDG layout: config in ~/.config/vim (read natively since Vim 9.1.0327),
" history and netrw bookmarks in ~/.local/state/vim.
let s:vimdir = expand('~/.config/vim')
let s:statedir = expand('~/.local/state/vim')
if !isdirectory(s:statedir)
    call mkdir(s:statedir, 'p')
endif
let &viminfofile = s:statedir . '/viminfo'
let g:netrw_home = s:statedir

" ============================================
" Plugin management (NeoBundle)
" ============================================
if has('vim_starting')
    " Clone NeoBundle on first start
    if !isdirectory(s:vimdir . '/bundle/neobundle.vim/')
        echo "Installing neobundle..."
        call system('git clone https://github.com/Shougo/neobundle.vim ' . shellescape(s:vimdir . '/bundle/neobundle.vim'))
    endif
    let &runtimepath .= ',' . s:vimdir . '/bundle/neobundle.vim/'
endif

call neobundle#begin(s:vimdir . '/bundle')
let g:neobundle_default_git_protocol='https'

" Plugins
NeoBundleFetch 'Shougo/neobundle.vim'        " NeoBundle itself
NeoBundle 'vimoutliner/vimoutliner'          " Outline editing
NeoBundle 'itchyny/lightline.vim'            " Status line
NeoBundle 'w0ng/vim-hybrid'                  " Color scheme
NeoBundle 'Shougo/vinarise.vim'              " Hex editor
NeoBundle 'Shougo/unite.vim'                 " Unified search/list interface
NeoBundle 'Shougo/vimshell.vim'              " Shell inside Vim
NeoBundle 'Shougo/vimproc'                   " Async process library used by the above

" Offer to install missing plugins, then finish loading
NeoBundleCheck
call neobundle#end()

filetype plugin indent on

" ============================================
" Display
" ============================================
" Colors
set t_Co=256                                 " 256-color terminal
syntax on
colorscheme hybrid
set bg=dark

" Line numbers and ruler
set number
set ruler                                    " Line and column in the bottom right

" Cursor
set cursorline                              " Highlight the current line
set cursorcolumn                            " Highlight the current column

" Wrapping and scrolling
set wrap                                    " Soft-wrap long lines
set textwidth=0                             " Never hard-wrap while typing
set scrolloff=5                             " Keep 5 lines visible around the cursor

" Invisible characters
set list
set listchars=tab:»-,trail:-,extends:»,precedes:«,nbsp:%,eol:↓

" Status line
set laststatus=2                            " Always show the status line
set showcmd                                 " Show partial commands at the bottom

" ============================================
" Encoding
" ============================================
set encoding=utf8                           " Internal encoding
set fileencoding=utf-8                      " Encoding for written files

" ============================================
" Files
" ============================================
" No swap or backup files
set noswapfile
set nowritebackup
set nobackup

" Buffers
set hidden                                  " Switch buffers without saving first
set switchbuf=useopen                       " Jump to a window already showing the buffer

" ============================================
" Indentation
" ============================================
set tabstop=4                               " Width of a tab character
set shiftwidth=4                            " Width of one indent level
set autoindent
set expandtab                               " Indent with spaces
set shiftround                              " Round indents to a multiple of shiftwidth

" ============================================
" Search
" ============================================
set ignorecase                              " Case-insensitive search...
set smartcase                               " ...unless the pattern has uppercase
set incsearch                               " Search as you type
set hlsearch                                " Highlight matches

set history=10000                           " Command and search history entries

" ============================================
" Completion
" ============================================
set infercase                               " Adjust the case of completed words to the typed text

" ============================================
" Matching pairs
" ============================================
set matchpairs& matchpairs+=<:>             " Treat < > as a pair too
set showmatch                               " Briefly jump to the matching bracket
set matchtime=3                             " ...for 0.3 seconds

" ============================================
" Movement
" ============================================
set nostartofline                           " Keep the column when moving between lines

" ============================================
" Backspace
" ============================================
set backspace=indent,eol,start              " Backspace over indents, line breaks and the insert start

" ============================================
" Bell
" ============================================
set vb t_vb=                                " No beep and no flash

" ============================================
" Clipboard
" ============================================
" set clipboard+=unnamed                      " Use the system clipboard
" set clipboard=unnamed                       " Yank into the system clipboard

" ============================================
" Mouse
" ============================================
"set mouse=a                                " Mouse support (off)
set ttymouse=xterm2                         " Mouse protocol for xterm and screen

" ============================================
" Key mappings
" ============================================

" === Basics ===
" x deletes into the black hole register (visual-mode x still yanks)
nnoremap x "_x

" jj leaves insert mode
inoremap jj <Esc>

" Esc twice clears the search highlight
nmap <silent> <Esc><Esc> :nohlsearch<CR>

" :w!! writes the file through sudo
cmap w!! w !sudo tee > /dev/null %

" === Search ===
" * in visual mode searches for the selected text
vnoremap <silent> * "vy/\V<C-r>=substitute(escape(@v, '\/'), "\n", '\\n', 'g')<CR><CR>

" Center the match on screen after jumping to it
nnoremap n nzz
nnoremap N Nzz
nnoremap * *zz
nnoremap # #zz
nnoremap g* g*zz
nnoremap g# g#zz

" === Movement ===
" j/k move by screen line, not by file line, through wrapped lines
nnoremap <silent> j gj
nnoremap <silent> k gk

" vv selects to the end of the line
vnoremap v $h

" Tab jumps to the matching pair
nnoremap <Tab> %
vnoremap <Tab> %

" === Windows ===
" Ctrl + h/j/k/l moves between windows
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Shift + arrows resize the window
nnoremap <S-Left>  <C-w><<CR>
nnoremap <S-Right> <C-w>><CR>
nnoremap <S-Up>    <C-w>-<CR>
nnoremap <S-Down>  <C-w>+<CR>

" === Cursor keys in insert mode ===
inoremap <c-d> <delete>
inoremap <c-j> <down>
inoremap <c-k> <up>
inoremap <c-h> <left>
inoremap <c-l> <right>

" === Line start and end ===
" Ctrl+E / Ctrl+A go to the end / first non-blank of the line, as in the shell
:map! <C-e> <Esc>$a
:map! <C-a> <Esc>^i
:map <C-e> <Esc>$a
:map <C-a> <Esc>^i

" === Toggles ===
" T followed by a key toggles an option and echoes its new value
nnoremap [toggle] <Nop>
nmap T [toggle]
" Ts: spell checking
nnoremap <silent> [toggle]s :setl spell!<CR>:setl spell?<CR>
" Tl: invisible characters
nnoremap <silent> [toggle]l :setl list!<CR>:setl list?<CR>
" Tt: expand tabs to spaces
nnoremap <silent> [toggle]t :setl expandtab!<CR>:setl expandtab?<CR>
" Tw: soft wrap
nnoremap <silent> [toggle]w :setl wrap!<CR>:setl wrap?<CR>
" Tp: paste mode
nnoremap <silent> [toggle]p :setl paste!<CR>:setl paste?<CR>

" ============================================
" Japanese text support
" ============================================
" Underline full-width (ideographic) spaces, which look like plain spaces
function! ZenkakuSpace()
  highlight ZenkakuSpace cterm=underline ctermfg=darkgrey gui=underline guifg=darkgrey
endfunction

if has('syntax')
  augroup ZenkakuSpace
    autocmd!
    " Color schemes reset highlights; define the group again after each one
    autocmd ColorScheme       * call ZenkakuSpace()
    " Match U+3000 in every window
    autocmd VimEnter,WinEnter * match ZenkakuSpace /　/
  augroup END
  call ZenkakuSpace()
endif

" ============================================
" Status line (lightline)
" ============================================
let g:lightline = {
        \ 'colorscheme': 'wombat',
        \ 'mode_map': {'c': 'NORMAL'},
        \ 'active': {
        \   'left': [ [ 'mode', 'paste' ], [ 'filename' ] ]
        \ },
        \ 'component_function': {
        \   'modified': 'LightLineModified',
        \   'readonly': 'LightLineReadonly',
        \   'filename': 'LightLineFilename',
        \   'fileformat': 'LightLineFileformat',
        \   'filetype': 'LightLineFiletype',
        \   'fileencoding': 'LightLineFileencoding',
        \   'mode': 'LightLineMode'
        \ }
        \ }

" Components for lightline. Plugin buffers (help, vimfiler, unite, ...) get
" no modified/readonly marks, and narrow windows drop the minor fields.
function! LightLineModified()
  return &ft =~ 'help\|vimfiler\|gundo' ? '' : &modified ? '+' : &modifiable ? '' : '-'
endfunction

function! LightLineReadonly()
  return &ft !~? 'help\|vimfiler\|gundo' && &readonly ? 'x' : ''
endfunction

function! LightLineFilename()
  return ('' != LightLineReadonly() ? LightLineReadonly() . ' ' : '') .
        \ (&ft == 'vimfiler' ? vimfiler#get_status_string() :
        \  &ft == 'unite' ? unite#get_status_string() :
        \  &ft == 'vimshell' ? vimshell#get_status_string() :
        \ '' != expand('%:t') ? expand('%:t') : '[No Name]') .
        \ ('' != LightLineModified() ? ' ' . LightLineModified() : '')
endfunction

function! LightLineFileformat()
  return winwidth(0) > 70 ? &fileformat : ''
endfunction

function! LightLineFiletype()
  return winwidth(0) > 70 ? (&filetype !=# '' ? &filetype : 'no ft') : ''
endfunction

function! LightLineFileencoding()
  return winwidth(0) > 70 ? (&fenc !=# '' ? &fenc : &enc) : ''
endfunction

function! LightLineMode()
  return winwidth(0) > 60 ? lightline#mode() : ''
endfunction

" ============================================
" Local overrides
" ============================================
" Source ~/.config/vim/vimrc.local when it exists (kept out of the repo)
let s:local_vimrc = s:vimdir . '/vimrc.local'
if filereadable(s:local_vimrc)
    execute 'source ' . s:local_vimrc
endif
